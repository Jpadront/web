---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TarjetaEntrada from '../../../components/TarjetaEntrada.astro';
import { contarEtiquetas, getEntradas, slugEtiqueta } from '../../../lib/contenido';

// Una página por etiqueta usada en alguna entrada
export const getStaticPaths = (async () => {
  const entradas = await getEntradas();
  return contarEtiquetas(entradas).map((t) => ({
    params: { slug: t.slug },
    props: {
      nombre: t.nombre,
      entradas: entradas.filter((e) => e.data.etiquetas.some((x) => slugEtiqueta(x) === t.slug)),
    },
  }));
}) satisfies GetStaticPaths;

const { nombre, entradas } = Astro.props;
---

<BaseLayout titulo={`#${nombre}`} descripcion={`Entradas de la bitácora con la etiqueta «${nombre}».`}>
  <div class="contenedor seccion">
    <header>
      <p class="etiqueta"><a href="/bitacora/">Bitácora</a> / Etiqueta</p>
      <h1>#{nombre}</h1>
      <p class="etiqueta">{entradas.length} {entradas.length === 1 ? 'entrada' : 'entradas'}</p>
    </header>
    <div class="lista">
      {entradas.map((e) => <TarjetaEntrada entrada={e} />)}
    </div>
    <p><a class="enlace-flecha" href="/bitacora/">Toda la bitácora</a></p>
  </div>
</BaseLayout>

<style>
  header {
    margin-bottom: var(--e-12);
    padding-bottom: var(--e-6);
    border-bottom: 1px solid var(--linea);
  }
  h1 {
    margin: var(--e-3) 0 var(--e-2);
  }
  .lista {
    max-width: 52rem;
    margin-bottom: var(--e-8);
  }
</style>
