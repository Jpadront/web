---
import { sitio } from '../lib/sitio';
import BotonTema from './BotonTema.astro';
import Monograma from './Monograma.astro';

const enlaces = [
  { href: '/proyectos/', texto: 'Proyectos' },
  { href: '/bitacora/', texto: 'Bitácora' },
  { href: '/sobre-mi/', texto: 'Sobre mí' },
];
// Marca como activa la sección en la que estamos (también en sus subpáginas)
const ruta = Astro.url.pathname;
const activo = (href: string) => ruta.startsWith(href);
---

<header class:list={["cabecera", { "sobre-hero": ruta === "/" }]} data-cabecera>
  <div class="contenedor fila">
    <a class="marca" href="/" aria-label={`${sitio.nombre}, inicio`}>
      <Monograma />
      <span>{sitio.nombre}</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          enlaces.map((e) => (
            <li>
              <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <BotonTema />
  </div>
</header>

<script>
  // En la portada, la cabecera es oscura mientras está sobre el hero y vuelve a su color al bajar
  const cab = document.querySelector<HTMLElement>('[data-cabecera]');
  const hero = document.querySelector('[data-hero]');
  if (cab && hero) {
    new IntersectionObserver(([e]) => cab.classList.toggle('sobre-hero', e.isIntersecting), {
      rootMargin: '-64px 0px 0px 0px',
    }).observe(hero);
  } else cab?.classList.remove('sobre-hero');
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fondo) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--linea);
  }
  /* Sobre el hero oscuro de la portada */
  .cabecera {
    transition:
      background-color 300ms,
      border-color 300ms;
  }
  .sobre-hero {
    background: rgb(10 26 51 / 0.97);
    border-bottom-color: rgb(141 169 196 / 0.14);
  }
  .sobre-hero .marca,
  .sobre-hero nav a[aria-current='page'],
  .sobre-hero nav a:hover {
    color: #fff;
  }
  .sobre-hero nav a {
    color: #a1afc3;
  }
  .sobre-hero nav a:hover,
  .sobre-hero nav a[aria-current='page'] {
    background: rgb(255 255 255 / 0.08);
    box-shadow: none;
  }
  .sobre-hero :global(.boton-tema) {
    color: #a1afc3;
  }
  .sobre-hero :global(.boton-tema:hover) {
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }
  .fila {
    display: flex;
    align-items: center;
    gap: var(--e-4);
    min-height: 3.75rem;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-right: auto;
    color: var(--tinta);
    text-decoration: none;
    font-weight: 620;
    font-size: 0.98rem;
    letter-spacing: -0.02em;
  }
  ul {
    display: flex;
    gap: var(--e-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.38rem 0.8rem;
    border-radius: 999px;
    color: var(--tinta-2);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition:
      color var(--transicion),
      background-color var(--transicion);
  }
  nav a:hover {
    color: var(--tinta);
    background: var(--superficie);
  }
  /* Sección actual: pastilla con borde fino */
  nav a[aria-current='page'] {
    color: var(--tinta);
    background: var(--superficie);
    box-shadow: inset 0 0 0 1px var(--linea);
  }
  /* En móvil: nombre y botón de tema arriba, navegación en una segunda línea */
  @media (max-width: 560px) {
    .fila {
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: var(--e-2);
    }
    nav {
      order: 3;
      width: 100%;
      border-top: 1px solid var(--linea);
      margin-top: var(--e-2);
    }
    nav {
      padding-block: var(--e-2);
    }
    nav li:first-child a {
      margin-left: -0.8rem;
    }
  }
</style>
