---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Etiquetas from '../../components/Etiquetas.astro';
import FichaRegata from '../../components/FichaRegata.astro';
import { fechaISO, formatoFecha, getEntradas, type Entrada } from '../../lib/contenido';

export const getStaticPaths = (async () => {
  const entradas = await getEntradas();
  // Anterior / siguiente dentro del orden cronológico
  return entradas.map((entrada, i) => ({
    params: { id: entrada.id },
    props: { entrada, posterior: entradas[i - 1], anterior: entradas[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entrada: Entrada;
  anterior?: Entrada;
  posterior?: Entrada;
}
const { entrada, anterior, posterior } = Astro.props;
const d = entrada.data;
const proyecto = d.proyecto ? await getEntry(d.proyecto) : undefined;
const { Content } = await render(entrada);
---

<BaseLayout titulo={d.titulo} descripcion={d.resumen} imagen={d.portada} tipo="article" fecha={d.fecha}>
  <article class="contenedor seccion">
    <header class="estrecho">
      <p class="antetitulo">
        <a href="/bitacora/">Bitácora</a>
        {proyecto && <> · <a href={`/proyectos/${proyecto.id}/`}>{proyecto.data.titulo}</a></>}
      </p>
      <h1>{d.titulo}</h1>
      <p class="texto-suave"><time datetime={fechaISO(d.fecha)}>{formatoFecha(d.fecha)}</time></p>
      <Etiquetas etiquetas={d.etiquetas} />
    </header>

    {d.regata.nombre && <div class="estrecho"><FichaRegata regata={d.regata} /></div>}

    {
      d.portada && (
        <Image
          class="portada"
          src={d.portada}
          alt={d.portada_alt ?? ''}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1000px) 100vw, 960px"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <div class="prosa">
      <Content />
    </div>

    <nav class="navegacion estrecho" aria-label="Más entradas">
      {anterior ? <a href={`/bitacora/${anterior.id}/`}>← {anterior.data.titulo}</a> : <span />}
      {posterior && <a class="derecha" href={`/bitacora/${posterior.id}/`}>{posterior.data.titulo} →</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  header {
    margin-bottom: 1.5rem;
  }
  .portada {
    width: 100%;
    max-width: 60rem;
    border-radius: var(--radio);
    margin: 1rem 0 2rem;
  }
  .navegacion {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--borde);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .derecha {
    text-align: right;
  }
</style>
