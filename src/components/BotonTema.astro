---
// Botón para alternar modo claro/oscuro. La preferencia se guarda en localStorage;
// el tema inicial se aplica con un script en <head> (ver BaseLayout) para evitar parpadeos.
---

<button class="boton-tema" type="button" aria-label="Cambiar entre modo claro y oscuro" title="Modo claro / oscuro">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <!-- Un círculo partido: la mitad rellena indica el modo al que se cambia -->
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path class="mitad" d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const oscuroAhora = () => {
    const t = document.documentElement.dataset.tema;
    if (t) return t === 'oscuro';
    return matchMedia('(prefers-color-scheme: dark)').matches;
  };
  for (const b of document.querySelectorAll<HTMLButtonElement>('.boton-tema')) {
    b.addEventListener('click', () => {
      const nuevo = oscuroAhora() ? 'claro' : 'oscuro';
      document.documentElement.dataset.tema = nuevo;
      try {
        localStorage.setItem('tema', nuevo);
      } catch {
        /* navegación privada: no pasa nada, solo no se recuerda */
      }
    });
  }
</script>

<style>
  .boton-tema {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-right: -0.4rem;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--tinta-2);
    cursor: pointer;
    transition:
      color var(--transicion),
      background-color var(--transicion);
  }
  .boton-tema:hover {
    color: var(--tinta);
    background: var(--superficie);
  }
  .mitad {
    transform-origin: 12px 12px;
    transition: transform 400ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  /* En oscuro la mitad rellena gira al otro lado */
  :global(:root[data-tema='oscuro']) .mitad {
    transform: rotate(180deg);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-tema='claro'])) .mitad {
      transform: rotate(180deg);
    }
  }
</style>
