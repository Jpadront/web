---
import { slugEtiqueta } from '../lib/contenido';

interface Props {
  etiquetas: string[];
  /** Si es true, cada etiqueta enlaza a su página de la bitácora */
  enlazar?: boolean;
}
const { etiquetas, enlazar = true } = Astro.props;
---

{
  etiquetas.length > 0 && (
    <ul class="etiquetas" aria-label="Etiquetas">
      {etiquetas.map((e) => (
        <li>{enlazar ? <a class="chip" href={`/bitacora/etiqueta/${slugEtiqueta(e)}/`}>#{e}</a> : <span class="chip">#{e}</span>}</li>
      ))}
    </ul>
  )
}

<style>
  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
