---
// Una fila de la bitácora: fecha a la izquierda (como en un cuaderno) y el resto a la derecha
import { getEntry } from 'astro:content';
import { fechaISO, formatoFechaCorta, textoPosicion, type Entrada } from '../lib/contenido';

interface Props {
  entrada: Entrada;
  /** Oculta el nombre del proyecto (útil dentro de la propia página del proyecto) */
  sinProyecto?: boolean;
}
const { entrada, sinProyecto = false } = Astro.props;
const d = entrada.data;
const proyecto = !sinProyecto && d.proyecto ? await getEntry(d.proyecto) : undefined;
const posicion = textoPosicion(d.regata.posicion, d.regata.participantes);
---

<article class="entrada">
  <time class="fecha mono" datetime={fechaISO(d.fecha)}>{formatoFechaCorta(d.fecha)}</time>
  <div class="cuerpo">
    <h3><a href={`/bitacora/${entrada.id}/`}>{d.titulo}</a></h3>
    <p class="resumen">{d.resumen}</p>
    {
      (proyecto || d.regata.nombre || d.borrador) && (
        <p class="meta etiqueta">
          {proyecto && <span>{proyecto.data.titulo}</span>}
          {d.regata.nombre && <span>{d.regata.nombre}</span>}
          {posicion && <span class="posicion">{posicion}</span>}
          {d.borrador && <span class="posicion">Borrador</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  .entrada {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--e-1) var(--e-6);
    padding: var(--e-6) 0;
    border-bottom: 1px solid var(--linea);
  }
  .entrada:first-child {
    padding-top: 0;
  }
  .fecha {
    padding-top: 0.42rem;
    font-size: 0.78rem;
    color: var(--tinta-3);
    letter-spacing: 0.02em;
  }
  h3 {
    margin: 0 0 var(--e-1);
    font-size: 1.35rem;
    line-height: 1.25;
  }
  h3 a {
    color: var(--tinta);
    text-decoration: none;
    transition: color var(--transicion);
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .entrada:hover h3 a {
    color: var(--acento-texto);
  }
  .resumen {
    margin: 0;
    color: var(--tinta-2);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: var(--e-3) 0 0;
  }
  .posicion {
    color: var(--acento-texto);
  }
  @media (max-width: 600px) {
    .entrada {
      grid-template-columns: minmax(0, 1fr);
    }
    .fecha {
      padding-top: 0;
    }
  }
</style>
