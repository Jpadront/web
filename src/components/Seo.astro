---
// Metadatos SEO y Open Graph de cada página.
// La imagen para redes se genera optimizada (1200×630, JPG) a partir de la portada;
// si la página no tiene portada se usa public/og-default.png.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sitio } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: ImageMetadata;
  tipo?: 'website' | 'article';
  fecha?: Date;
  noIndexar?: boolean;
}
const { titulo, descripcion, imagen, tipo = 'website', fecha, noIndexar = false } = Astro.props;

const tituloCompleto = titulo === sitio.titulo ? titulo : `${titulo} · ${sitio.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const og = imagen
  ? (await getImage({ src: imagen, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : '/og-default.png';
const ogAbsoluta = new URL(og, Astro.site);
---

<title>{tituloCompleto}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonica} />
{noIndexar && <meta name="robots" content="noindex" />}

<meta property="og:type" content={tipo} />
<meta property="og:site_name" content={sitio.nombre} />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonica} />
<meta property="og:image" content={ogAbsoluta} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{fecha && <meta property="article:published_time" content={fecha.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={ogAbsoluta} />
