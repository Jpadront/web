---
import { sitio } from '../lib/sitio';
import RedesSociales from './RedesSociales.astro';
import Monograma from './Monograma.astro';
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor">
    <div class="fila">
      <div class="firma">
        <Monograma tamano={22} />
        <span>{sitio.nombre}</span>
      </div>
      <nav aria-label="Pie de página">
        <a href="/proyectos/">Proyectos</a>
        <a href="/bitacora/">Bitácora</a>
        <a href="/sobre-mi/">Sobre mí</a>
        <a href="/calculadora-orc/">Calculadora ORC</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <RedesSociales />
    </div>
    <p class="colofon">
      © {anio} {sitio.nombre}. Hecha a mano con <a href="https://astro.build">Astro</a> y publicada en Cloudflare Pages. Sin
      cookies ni analítica.
    </p>
  </div>
</footer>

<style>
  .pie {
    margin-top: var(--e-24);
    border-top: 1px solid var(--linea);
    font-size: 0.88rem;
    color: var(--tinta-2);
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4) var(--e-8);
    padding-block: var(--e-8) var(--e-6);
  }
  .firma {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--tinta);
    font-weight: 600;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-6);
  }
  nav a {
    color: var(--tinta-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--tinta);
  }
  .colofon {
    margin: 0;
    padding-block: var(--e-4) var(--e-8);
    border-top: 1px solid var(--linea);
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--tinta-3);
  }
  .colofon a {
    color: inherit;
  }
</style>
