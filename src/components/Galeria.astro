---
// Galería de imágenes con visor a pantalla completa.
// Las miniaturas y la versión grande las genera Astro optimizadas (WebP) al compilar.
// Sin JavaScript, cada miniatura abre la imagen grande en la misma pestaña.
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

interface Props {
  imagenes: { imagen: ImageMetadata; pie?: string }[];
  titulo?: string;
}
const { imagenes, titulo = 'Galería' } = Astro.props;
const grandes = await Promise.all(imagenes.map((i) => getImage({ src: i.imagen, width: Math.min(1800, i.imagen.width), format: 'webp' })));
---

{
  imagenes.length > 0 && (
    <section class="galeria" data-galeria>
      <h2>{titulo}</h2>
      <ul>
        {imagenes.map((img, i) => (
          <li>
            <figure>
              <a href={grandes[i].src} data-indice={i} data-pie={img.pie ?? ''}>
                <Image src={img.imagen} alt={img.pie ?? `Imagen ${i + 1}`} widths={[320, 480, 720]} sizes="(max-width: 640px) 50vw, 280px" />
              </a>
              {img.pie && <figcaption>{img.pie}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
      <dialog class="visor" aria-label="Imagen ampliada">
        <img alt="" />
        <p class="pie" />
        <button type="button" class="cerrar" data-cerrar aria-label="Cerrar">×</button>
        <button type="button" class="nav ant" data-mover="-1" aria-label="Anterior">‹</button>
        <button type="button" class="nav sig" data-mover="1" aria-label="Siguiente">›</button>
      </dialog>
    </section>
  )
}

<script>
  for (const galeria of document.querySelectorAll<HTMLElement>('[data-galeria]')) {
    const enlaces = [...galeria.querySelectorAll<HTMLAnchorElement>('a[data-indice]')];
    const visor = galeria.querySelector<HTMLDialogElement>('dialog')!;
    const img = visor.querySelector('img')!;
    const pie = visor.querySelector<HTMLElement>('.pie')!;
    let actual = 0;

    const mostrar = (i: number) => {
      actual = (i + enlaces.length) % enlaces.length;
      const a = enlaces[actual];
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      pie.textContent = a.dataset.pie ?? '';
    };
    enlaces.forEach((a, i) =>
      a.addEventListener('click', (ev) => {
        ev.preventDefault();
        mostrar(i);
        visor.showModal();
      }),
    );
    visor.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      if (t.closest('[data-cerrar]') || t === visor) visor.close();
      const mover = t.closest<HTMLElement>('[data-mover]')?.dataset.mover;
      if (mover) mostrar(actual + Number(mover));
    });
    visor.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowRight') mostrar(actual + 1);
      if (ev.key === 'ArrowLeft') mostrar(actual - 1);
    });
  }
</script>

<style>
  .galeria {
    margin: 2.5rem 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(45%, 15rem), 1fr));
  }
  figure {
    margin: 0;
  }
  a {
    display: block;
    border-radius: var(--radio);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--superficie);
  }
  a :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }
  a:hover :global(img) {
    transform: scale(1.03);
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--texto-suave);
    margin-top: 0.35rem;
  }
  .visor {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
  }
  .visor[open] {
    display: grid;
    place-items: center;
    align-content: center;
  }
  .visor::backdrop {
    background: rgb(5 12 24 / 0.92);
  }
  .visor img {
    max-width: 94vw;
    max-height: 82vh;
    width: auto;
    border-radius: 8px;
  }
  .visor .pie {
    color: #e8eef6;
    margin: 0.75rem 1rem 0;
    text-align: center;
  }
  .visor button {
    position: fixed;
    border: 0;
    border-radius: 50%;
    width: 2.75rem;
    height: 2.75rem;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .visor button:hover {
    background: var(--acento);
  }
  .cerrar {
    top: 1rem;
    right: 1rem;
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .ant {
    left: 0.75rem;
  }
  .sig {
    right: 0.75rem;
  }
</style>
