# Cabeceras para Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

# Los archivos de /_astro/ llevan un hash en el nombre: se pueden guardar en caché para siempre
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Que los STL/3MF se descarguen en lugar de intentar abrirse en el navegador
/descargas/*
  Content-Disposition: attachment
