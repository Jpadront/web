---
import { Image } from 'astro:assets';
import { CATEGORIAS, ESTADOS } from '../lib/constantes';
import type { Proyecto } from '../lib/contenido';

interface Props {
  proyecto: Proyecto;
  /** true en las primeras tarjetas visibles: carga la imagen sin esperar (mejor LCP) */
  prioridad?: boolean;
}
const { proyecto, prioridad = false } = Astro.props;
const d = proyecto.data;
---

<article class="tarjeta" data-categoria={d.categoria} data-estado={d.estado}>
  <div class="imagen">
    {
      d.portada ? (
        <Image
          src={d.portada}
          alt={d.portada_alt ?? ''}
          widths={[400, 640, 960]}
          sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px"
          loading={prioridad ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="sin-imagen" aria-hidden="true" />
      )
    }
  </div>
  <div class="cuerpo">
    <p class="meta">
      <span class="chip">{CATEGORIAS[d.categoria]}</span>
      <span class:list={['estado', `estado-${d.estado}`]}>{ESTADOS[d.estado]}</span>
      {d.borrador && <span class="chip">Borrador</span>}
    </p>
    <h3>
      <!-- El enlace ocupa toda la tarjeta (ver ::after) -->
      <a href={`/proyectos/${proyecto.id}/`}>{d.titulo}</a>
    </h3>
    <p class="resumen">{d.resumen}</p>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }
  .tarjeta:hover {
    transform: translateY(-2px);
    border-color: var(--acento);
  }
  .imagen {
    aspect-ratio: 16 / 9;
    background: var(--marino);
  }
  .imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sin-imagen {
    height: 100%;
    background: linear-gradient(135deg, var(--marino), var(--marino-2));
  }
  .cuerpo {
    padding: 1rem 1.15rem 1.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    color: var(--texto-suave);
  }
  h3 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
  }
  h3 a {
    color: var(--texto);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .resumen {
    margin: 0;
    color: var(--texto-suave);
    font-size: 0.95rem;
  }
  [hidden] {
    display: none;
  }
</style>
