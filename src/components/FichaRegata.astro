---
// Ficha con los datos de una regata (Diario de regatas)
import type { Entrada } from '../lib/contenido';
import { textoPosicion } from '../lib/contenido';

interface Props {
  regata: Entrada['data']['regata'];
}
const { regata: r } = Astro.props;
const filas = [
  ['Regata', r.nombre],
  ['Lugar', r.lugar],
  ['Barco', r.barco],
  ['Clase', r.clase],
  ['Posición', textoPosicion(r.posicion, r.participantes)],
  ['Pruebas', r.pruebas?.toString()],
  ['Viento', r.viento],
].filter(([, v]) => v) as [string, string][];
---

<aside class="ficha" aria-label="Datos de la regata">
  <dl>
    {
      filas.map(([k, v]) => (
        <div class:list={{ destacado: k === 'Posición' }}>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))
    }
  </dl>
  {r.notas && <p class="notas"><strong>Notas:</strong> {r.notas}</p>}
</aside>

<style>
  .ficha {
    border: 1px solid var(--borde);
    border-left: 4px solid var(--acento);
    border-radius: var(--radio);
    background: var(--superficie);
    padding: 1rem 1.2rem;
    margin: 1.5rem 0;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--texto-suave);
    font-weight: 700;
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .destacado dd {
    color: var(--acento-texto);
    font-size: 1.15rem;
  }
  .notas {
    margin: 0.9rem 0 0;
    font-size: 0.95rem;
  }
</style>
