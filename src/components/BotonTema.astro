---
// Botón para alternar modo claro/oscuro. La preferencia se guarda en localStorage;
// el tema inicial se aplica con un script en <head> (ver BaseLayout) para evitar parpadeos.
---

<button class="boton-tema" type="button" aria-label="Cambiar entre modo claro y oscuro" title="Modo claro / oscuro">
  <svg class="icono-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icono-luna" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  const oscuroAhora = () => {
    const t = document.documentElement.dataset.tema;
    if (t) return t === 'oscuro';
    return matchMedia('(prefers-color-scheme: dark)').matches;
  };
  for (const b of document.querySelectorAll<HTMLButtonElement>('.boton-tema')) {
    b.addEventListener('click', () => {
      const nuevo = oscuroAhora() ? 'claro' : 'oscuro';
      document.documentElement.dataset.tema = nuevo;
      try {
        localStorage.setItem('tema', nuevo);
      } catch {
        /* navegación privada: no pasa nada, solo no se recuerda */
      }
    });
  }
</script>

<style>
  .boton-tema {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--borde);
    background: transparent;
    color: var(--texto);
    cursor: pointer;
  }
  .boton-tema:hover {
    border-color: var(--acento);
  }
  /* En claro se muestra la luna (pasar a oscuro); en oscuro, el sol */
  .icono-sol {
    display: none;
  }
  :global(:root[data-tema='oscuro']) .icono-sol {
    display: block;
  }
  :global(:root[data-tema='oscuro']) .icono-luna {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-tema='claro'])) .icono-sol {
      display: block;
    }
    :global(:root:not([data-tema='claro'])) .icono-luna {
      display: none;
    }
  }
</style>
