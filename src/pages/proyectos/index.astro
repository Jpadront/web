---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TarjetaProyecto from '../../components/TarjetaProyecto.astro';
import { CATEGORIAS, ESTADOS } from '../../lib/constantes';
import { getProyectos } from '../../lib/contenido';

const proyectos = await getProyectos();

// Solo se ofrecen como filtro las categorías y estados que tienen algún proyecto, con su recuento
const usadas = <T extends string>(clave: 'categoria' | 'estado', todas: Record<T, string>) =>
  (Object.entries(todas) as [T, string][])
    .map(([k, v]) => ({ k, v, n: proyectos.filter((p) => p.data[clave] === k).length }))
    .filter((x) => x.n > 0);
const categorias = usadas('categoria', CATEGORIAS);
const estados = usadas('estado', ESTADOS);
---

<BaseLayout titulo="Proyectos" descripcion="Todos mis proyectos: software, vela, impresión 3D y otros, con su estado actual.">
  <div class="contenedor seccion">
    <header class="cabecera-pagina">
      <p class="etiqueta">Proyectos</p>
      <h1>Lo que estoy construyendo</h1>
      <p class="entradilla">Herramientas, crónicas y piezas: cada proyecto con su estado y lo que he ido aprendiendo por el camino.</p>
    </header>

    <!-- Filtros: funcionan en el navegador (sin recargar) y se guardan en la URL (?categoria=vela&estado=terminado) -->
    <form class="filtros" aria-label="Filtrar proyectos" data-filtros>
      <fieldset>
        <legend class="etiqueta">Categoría</legend>
        <div class="opciones">
          <label><input type="radio" name="categoria" value="" checked />Todas<span class="n">{proyectos.length}</span></label>
          {
            categorias.map((c) => (
              <label>
                <input type="radio" name="categoria" value={c.k} />
                {c.v}
                <span class="n">{c.n}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset>
        <legend class="etiqueta">Estado</legend>
        <div class="opciones">
          <label><input type="radio" name="estado" value="" checked />Todos</label>
          {
            estados.map((e) => (
              <label>
                <input type="radio" name="estado" value={e.k} />
                {e.v}
                <span class="n">{e.n}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <p class="contador etiqueta" aria-live="polite" data-contador>{proyectos.length} proyectos</p>
    </form>

    <div class="rejilla" data-lista>
      {proyectos.map((p, i) => <TarjetaProyecto proyecto={p} numero={i + 1} prioridad={i < 2} />)}
    </div>
    <p class="vacio texto-suave" data-vacio hidden>
      No hay proyectos con esos filtros. <button type="button" class="limpiar" data-limpiar>Quitar filtros</button>
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filtros]')!;
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-lista] > [data-categoria]')];
  const contador = document.querySelector<HTMLElement>('[data-contador]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;

  function aplicar() {
    const datos = new FormData(form);
    const categoria = String(datos.get('categoria') ?? '');
    const estado = String(datos.get('estado') ?? '');
    let visibles = 0;
    for (const t of tarjetas) {
      const ok = (!categoria || t.dataset.categoria === categoria) && (!estado || t.dataset.estado === estado);
      t.hidden = !ok;
      if (ok) visibles++;
    }
    contador.textContent = `${visibles} ${visibles === 1 ? 'proyecto' : 'proyectos'}`;
    vacio.hidden = visibles > 0;
    // Guarda el filtro en la URL para poder compartir el enlace filtrado
    const url = new URL(location.href);
    categoria ? url.searchParams.set('categoria', categoria) : url.searchParams.delete('categoria');
    estado ? url.searchParams.set('estado', estado) : url.searchParams.delete('estado');
    history.replaceState(null, '', url);
  }

  // Al cargar, aplica los filtros que vengan en la URL
  const params = new URLSearchParams(location.search);
  for (const nombre of ['categoria', 'estado']) {
    const valor = params.get(nombre);
    const input = valor && form.querySelector<HTMLInputElement>(`input[name="${nombre}"][value="${CSS.escape(valor)}"]`);
    if (input) input.checked = true;
  }
  form.addEventListener('change', aplicar);
  document.querySelector('[data-limpiar]')?.addEventListener('click', () => {
    form.reset();
    aplicar();
  });
  aplicar();
</script>

<style>
  .cabecera-pagina {
    margin-bottom: var(--e-12);
  }
  .cabecera-pagina h1 {
    margin: var(--e-3) 0 var(--e-4);
  }
  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--e-4) var(--e-12);
    padding: var(--e-4) var(--e-6);
    margin-bottom: var(--e-12);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--superficie);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  legend {
    padding: 0;
    margin-bottom: var(--e-2);
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }
  /* Opciones como pastillas; la elegida, en marino (o claro en modo oscuro) */
  label {
    position: relative;
    cursor: pointer;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: var(--fondo);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--tinta-2);
    transition:
      color var(--transicion),
      border-color var(--transicion),
      background-color var(--transicion);
  }
  label:hover {
    color: var(--tinta);
    border-color: var(--linea-fuerte);
  }
  label:has(input:checked) {
    color: var(--fondo);
    background: var(--tinta);
    border-color: var(--tinta);
  }
  label:has(input:checked) .n {
    color: inherit;
    opacity: 0.6;
  }
  label:has(input:focus-visible) {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
    border-radius: var(--radio-pequeno);
  }
  .n {
    margin-left: 0.3em;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--tinta-3);
    vertical-align: 0.1em;
  }
  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .contador {
    margin: 0 0 0 auto;
    padding-bottom: 0.25rem;
  }
  .rejilla {
    display: grid;
    gap: var(--e-6);
  }
  @media (min-width: 700px) {
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .limpiar {
    font: inherit;
    color: var(--tinta);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-decoration-color: var(--acento);
    text-underline-offset: 0.22em;
    cursor: pointer;
  }
  @media (max-width: 600px) {
    .contador {
      margin-left: 0;
    }
  }
</style>
