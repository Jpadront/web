---
// Tabla resumen del Diario de regatas: una fila por crónica con datos de regata
import { fechaISO, formatoFechaCorta, type Entrada } from '../lib/contenido';

interface Props {
  entradas: Entrada[];
}
const { entradas } = Astro.props;
---

<div class="tabla-envoltorio">
  <table>
    <caption class="solo-lectores">Resultados de las regatas</caption>
    <thead>
      <tr>
        <th scope="col">Fecha</th>
        <th scope="col">Regata</th>
        <th scope="col">Clase</th>
        <th scope="col" class="num">Posición</th>
      </tr>
    </thead>
    <tbody>
      {
        entradas.map((e) => {
          const r = e.data.regata;
          return (
            <tr>
              <td class="mono fecha">
                <time datetime={fechaISO(e.data.fecha)}>{formatoFechaCorta(e.data.fecha)}</time>
              </td>
              <td>
                <a href={`/bitacora/${e.id}/`}>{r.nombre}</a>
              </td>
              <td class="texto-suave">{r.clase ?? '—'}</td>
              <td class="num">
                {r.posicion ? <strong>{r.posicion}.º</strong> : '—'}
                {r.posicion && r.participantes && <span class="de"> / {r.participantes}</span>}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .tabla-envoltorio {
    overflow-x: auto;
    max-width: 52rem;
    margin: 0 0 var(--e-12);
  }
  table {
    min-width: 30rem;
  }
  th,
  td {
    padding: var(--e-3) var(--e-4) var(--e-3) 0;
  }
  thead th {
    border-bottom-color: var(--tinta);
  }
  .fecha {
    color: var(--tinta-3);
    white-space: nowrap;
  }
  td a {
    text-decoration-color: var(--linea-fuerte);
  }
  .num {
    text-align: right;
    white-space: nowrap;
    padding-right: 0;
  }
  strong {
    font-weight: 600;
    color: var(--acento-texto);
  }
  .de {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--tinta-3);
  }
</style>
