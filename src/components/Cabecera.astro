---
import { sitio } from '../lib/sitio';
import BotonTema from './BotonTema.astro';
import Gallardete from './Gallardete.astro';

const enlaces = [
  { href: '/proyectos/', texto: 'Proyectos' },
  { href: '/bitacora/', texto: 'Bitácora' },
  { href: '/sobre-mi/', texto: 'Sobre mí' },
];
// Marca como activa la sección en la que estamos (también en sus subpáginas)
const ruta = Astro.url.pathname;
const activo = (href: string) => ruta.startsWith(href);
---

<header class="cabecera">
  <div class="contenedor fila">
    <a class="marca" href="/" aria-label={`${sitio.nombre}, inicio`}>
      <Gallardete />
      <span>{sitio.nombre}</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          enlaces.map((e) => (
            <li>
              <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <BotonTema />
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fondo) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--linea);
  }
  .fila {
    display: flex;
    align-items: center;
    gap: var(--e-4);
    min-height: 3.75rem;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-right: auto;
    color: var(--tinta);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }
  .marca :global(.gallardete) {
    transition: transform 400ms cubic-bezier(0.3, 1.5, 0.5, 1);
    transform-origin: 20% 50%;
  }
  /* Detalle: el gallardete «ondea» un poco al pasar el ratón */
  .marca:hover :global(.gallardete) {
    transform: skewY(-6deg);
  }
  ul {
    display: flex;
    gap: var(--e-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: block;
    padding-block: 0.4rem;
    color: var(--tinta-2);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }
  nav a:hover {
    color: var(--tinta);
  }
  nav a[aria-current='page'] {
    color: var(--tinta);
  }
  /* Indicador de sección actual: un trazo fino de acento bajo el enlace */
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.05rem;
    height: 1.5px;
    background: var(--acento);
  }
  /* En móvil: nombre y botón de tema arriba, navegación en una segunda línea */
  @media (max-width: 560px) {
    .fila {
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: var(--e-2);
    }
    nav {
      order: 3;
      width: 100%;
      border-top: 1px solid var(--linea);
      margin-top: var(--e-2);
    }
    ul {
      gap: var(--e-6);
    }
    nav a {
      padding-block: 0.55rem;
    }
  }
</style>
