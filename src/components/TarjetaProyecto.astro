---
import { Image } from 'astro:assets';
import { CATEGORIAS, ESTADOS } from '../lib/constantes';
import { dosCifras, type Proyecto } from '../lib/contenido';

interface Props {
  proyecto: Proyecto;
  /** Número de orden que se muestra («01», «02»…) */
  numero?: number;
  /** true en las primeras tarjetas visibles: carga la imagen sin esperar (mejor LCP) */
  prioridad?: boolean;
}
const { proyecto, numero, prioridad = false } = Astro.props;
const d = proyecto.data;
---

<article class="tarjeta" data-foco data-categoria={d.categoria} data-estado={d.estado}>
  <div class="imagen">
    {
      d.portada ? (
        <Image
          src={d.portada}
          alt={d.portada_alt ?? ''}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1200px) 46vw, 560px"
          loading={prioridad ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="sin-imagen" aria-hidden="true" />
      )
    }
    <span class:list={['estado', 'pastilla', `estado-${d.estado}`]}>{ESTADOS[d.estado]}</span>
  </div>
  <div class="cuerpo">
    <p class="meta etiqueta">
      {numero != null && <span class="numero">{dosCifras(numero)}</span>}
      <span>{CATEGORIAS[d.categoria]}</span>
      <span>{d.fecha_inicio.getUTCFullYear()}</span>
      {d.borrador && <span class="numero">Borrador</span>}
    </p>
    <h3>
      <!-- El enlace ocupa toda la tarjeta (ver ::after) -->
      <a href={`/proyectos/${proyecto.id}/`}>{d.titulo}</a>
    </h3>
    <p class="resumen">{d.resumen}</p>
    <span class="ir" aria-hidden="true">→</span>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--fondo);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
    transition:
      transform 250ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 250ms cubic-bezier(0.2, 0, 0, 1),
      border-color 250ms;
  }
  .tarjeta:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra-hover);
    border-color: color-mix(in srgb, var(--acento) 45%, var(--linea));
  }
  .imagen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--marino);
    border-bottom: 1px solid var(--linea);
  }
  .imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0, 0, 1);
  }
  .tarjeta:hover .imagen :global(img) {
    transform: scale(1.04);
  }
  .sin-imagen {
    height: 100%;
    background: linear-gradient(135deg, var(--marino), var(--marino-2));
  }
  /* Estado como pastilla «de cristal» sobre la imagen */
  .pastilla {
    position: absolute;
    top: var(--e-3);
    left: var(--e-3);
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 550;
    color: #fff;
    background: rgb(7 13 24 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--e-4) var(--e-6) var(--e-6);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin: 0 0 var(--e-2);
  }
  .numero {
    color: var(--acento-texto);
  }
  h3 {
    margin: 0 0 var(--e-2);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.45rem);
    letter-spacing: -0.03em;
  }
  h3 a {
    color: var(--tinta);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .resumen {
    margin: 0;
    padding-right: var(--e-8);
    color: var(--tinta-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  /* Flecha que aparece al pasar el ratón */
  .ir {
    position: absolute;
    bottom: var(--e-6);
    right: var(--e-6);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--linea);
    color: var(--tinta-3);
    transition:
      transform 250ms cubic-bezier(0.2, 0, 0, 1),
      background-color 250ms,
      color 250ms,
      border-color 250ms;
  }
  .tarjeta:hover .ir {
    transform: rotate(-45deg);
    background: var(--acento);
    border-color: var(--acento);
    color: #fff;
  }
</style>
