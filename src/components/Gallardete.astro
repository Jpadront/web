---
// Marca de la web: un gallardete (bandera triangular de un barco) dibujado en SVG.
// Usa currentColor para el asta y el paño, y el acento para la franja: se adapta al modo claro/oscuro.
interface Props {
  tamano?: number;
}
const { tamano = 22 } = Astro.props;
---

<svg class="gallardete" width={tamano} height={tamano} viewBox="0 0 24 24" aria-hidden="true">
  <path d="M5 2.5v19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"></path>
  <path d="M6.2 3.2 21 8.6 6.2 14Z" fill="currentColor"></path>
  <path d="M6.2 7.6 15 8.6 6.2 9.6Z" fill="var(--acento)"></path>
</svg>
