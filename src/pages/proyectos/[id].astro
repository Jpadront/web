---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Etiquetas from '../../components/Etiquetas.astro';
import TarjetaEntrada from '../../components/TarjetaEntrada.astro';
import TablaRegatas from '../../components/TablaRegatas.astro';
import Galeria from '../../components/Galeria.astro';
import Descargas from '../../components/Descargas.astro';
import CalculadoraOrc from '../../components/CalculadoraOrc.astro';
import { CATEGORIAS, ESTADOS } from '../../lib/constantes';
import { dosCifras, fechaISO, formatoMes, getEntradas, getProyectos, type Proyecto } from '../../lib/contenido';

export const getStaticPaths = (async () => {
  const proyectos = await getProyectos();
  return proyectos.map((proyecto, i) => ({
    params: { id: proyecto.id },
    props: { proyecto, numero: i + 1, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  proyecto: Proyecto;
  numero: number;
  siguiente: Proyecto;
}
const { proyecto, numero, siguiente } = Astro.props;
const d = proyecto.data;
const { Content } = await render(proyecto);

// Entradas de la bitácora vinculadas a este proyecto (campo «proyecto» de cada entrada)
const relacionadas = (await getEntradas()).filter((e) => e.data.proyecto?.id === proyecto.id);
const regatas = relacionadas.filter((e) => e.data.regata.nombre);

const enlaces = [
  d.enlaces.repositorio && { href: d.enlaces.repositorio, texto: 'Repositorio' },
  d.enlaces.demo && { href: d.enlaces.demo, texto: 'Demo' },
  d.enlaces.descarga && { href: d.enlaces.descarga, texto: 'Descarga' },
].filter(Boolean) as { href: string; texto: string }[];
const externo = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout titulo={d.titulo} descripcion={d.resumen} imagen={d.portada} tipo="article" fecha={d.fecha_inicio}>
  <article class="contenedor seccion">
    <header class="cabecera-proyecto">
      <div class="titulo">
        <p class="etiqueta">
          <a href="/proyectos/">Proyectos</a> / <span class="numero">{dosCifras(numero)}</span>
        </p>
        <h1>{d.titulo}</h1>
        <p class="entradilla">{d.resumen}</p>
      </div>

      <!-- Ficha técnica del proyecto -->
      <dl class="ficha">
        <div>
          <dt class="etiqueta">Estado</dt>
          <dd class:list={['estado', `estado-${d.estado}`]}>{ESTADOS[d.estado]}</dd>
        </div>
        <div>
          <dt class="etiqueta">Categoría</dt>
          <dd>{CATEGORIAS[d.categoria]}</dd>
        </div>
        <div>
          <dt class="etiqueta">Desde</dt>
          <dd><time datetime={fechaISO(d.fecha_inicio)}>{formatoMes(d.fecha_inicio)}</time></dd>
        </div>
        {
          relacionadas.length > 0 && (
            <div>
              <dt class="etiqueta">Bitácora</dt>
              <dd>
                <a href="#bitacora">
                  {relacionadas.length} {relacionadas.length === 1 ? 'entrada' : 'entradas'}
                </a>
              </dd>
            </div>
          )
        }
        {
          enlaces.length > 0 && (
            <div class="ancho">
              <dt class="etiqueta">Enlaces</dt>
              <dd class="enlaces">
                {enlaces.map((e) => (
                  <a href={e.href} rel={externo(e.href) ? 'noopener' : undefined}>
                    {e.texto}
                    <span aria-hidden="true">{externo(e.href) ? '↗' : '→'}</span>
                  </a>
                ))}
              </dd>
            </div>
          )
        }
        {
          d.etiquetas.length > 0 && (
            <div class="ancho">
              <dt class="etiqueta">Etiquetas</dt>
              <dd>
                <Etiquetas etiquetas={d.etiquetas} enlazar={false} />
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      d.portada && (
        <figure class="portada">
          <Image
            src={d.portada}
            alt={d.portada_alt ?? ''}
            widths={[720, 1080, 1440, 1920]}
            sizes="(max-width: 1240px) 94vw, 1160px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="prosa">
      <Content />
    </div>

    <!-- Herramienta interactiva elegida en el campo «herramienta» del proyecto -->
    {d.herramienta === 'calculadora-orc' && <CalculadoraOrc />}

    <Galeria imagenes={d.galeria} />
    <Descargas archivos={d.descargas} />

    {
      relacionadas.length > 0 && (
        <section id="bitacora" class="relacionadas">
          <div class="cabecera-seccion">
            <h2>Bitácora del proyecto</h2>
            <span class="etiqueta">
              {relacionadas.length} {relacionadas.length === 1 ? 'entrada' : 'entradas'}
            </span>
          </div>
          {regatas.length > 0 && <TablaRegatas entradas={regatas} />}
          <div class="lista">
            {relacionadas.map((e) => (
              <TarjetaEntrada entrada={e} sinProyecto />
            ))}
          </div>
        </section>
      )
    }

    {
      siguiente.id !== proyecto.id && (
        <nav class="siguiente" aria-label="Siguiente proyecto">
          <span class="etiqueta">Siguiente proyecto</span>
          <a href={`/proyectos/${siguiente.id}/`}>
            {siguiente.data.titulo} <span aria-hidden="true">→</span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .cabecera-proyecto {
    display: grid;
    gap: var(--e-8) var(--e-16);
    margin-bottom: var(--e-12);
  }
  @media (min-width: 960px) {
    .cabecera-proyecto {
      grid-template-columns: minmax(0, 1fr) 19rem;
      align-items: end;
    }
  }
  .titulo h1 {
    margin: var(--e-3) 0 var(--e-6);
  }
  .titulo .entradilla {
    margin: 0;
  }
  .numero {
    color: var(--acento-texto);
  }
  .ficha {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-top: 1px solid var(--tinta);
  }
  .ficha > div {
    padding: var(--e-3) var(--e-4) var(--e-3) 0;
    border-bottom: 1px solid var(--linea);
  }
  .ficha .ancho {
    grid-column: 1 / -1;
  }
  dd {
    margin: var(--e-1) 0 0;
    font-size: 0.95rem;
  }
  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-6);
  }
  .enlaces a {
    font-weight: 550;
    text-decoration: none;
  }
  .enlaces span {
    color: var(--acento-texto);
    margin-left: 0.15em;
  }
  .portada {
    margin: 0 0 var(--e-12);
  }
  .portada :global(img) {
    width: 100%;
    border-radius: var(--radio);
    box-shadow: 0 0 0 1px var(--linea);
  }
  .relacionadas {
    margin-top: var(--e-16);
  }
  .lista {
    max-width: 52rem;
  }
  .siguiente {
    display: grid;
    gap: var(--e-2);
    margin-top: var(--e-16);
    padding-top: var(--e-6);
    border-top: 1px solid var(--tinta);
  }
  .siguiente a {
    font-family: var(--titulos);
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.4rem);
    line-height: 1.15;
    text-decoration: none;
    color: var(--tinta);
  }
  .siguiente a span {
    display: inline-block;
    color: var(--acento-texto);
    transition: transform var(--transicion);
  }
  .siguiente a:hover span {
    transform: translateX(6px);
  }
</style>
