---
// Marca de la web: monograma «JP» (las mismas iniciales que llevan en relieve las piezas
// impresas). Es el mismo dibujo que public/favicon.svg.
interface Props {
  tamano?: number;
}
const { tamano = 28 } = Astro.props;
---

<svg class="monograma" width={tamano} height={tamano} viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" rx="15" fill="#0b2545"></rect>
  <rect x="1" y="1" width="62" height="62" rx="14" fill="none" stroke="#8da9c4" stroke-opacity=".25" stroke-width="2"></rect>
  <g fill="none" stroke="#eef2f6" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M25 16v19a9 9 0 0 1-9 9"></path>
    <path d="M35 44V16h7a8 8 0 0 1 0 16h-7"></path>
  </g>
  <circle class="punto" cx="50.5" cy="44" r="4.2" fill="#f26419"></circle>
</svg>

<style>
  .monograma {
    flex: none;
    border-radius: 24%;
  }
  .punto {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 300ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  /* Detalle: el punto naranja «late» al pasar el ratón por la marca */
  :global(a:hover) > .monograma .punto {
    transform: scale(1.35);
  }
</style>
