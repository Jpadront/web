---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titulo="Página no encontrada" descripcion="Esta página no existe." noIndexar>
  <div class="contenedor seccion error">
    <p class="etiqueta">Error 404 · Fuera del recorrido</p>
    <h1>Aquí no hay baliza</h1>
    <p class="entradilla">La página que buscas no existe o ha cambiado de sitio. Volvamos a la línea de salida.</p>
    <p class="acciones">
      <a class="enlace-flecha" href="/">Inicio</a>
      <a class="enlace-flecha" href="/proyectos/">Proyectos</a>
      <a class="enlace-flecha" href="/bitacora/">Bitácora</a>
    </p>
  </div>
</BaseLayout>

<style>
  .error {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  h1 {
    margin: var(--e-3) 0 var(--e-6);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3) var(--e-8);
    margin-top: var(--e-4);
  }
</style>
