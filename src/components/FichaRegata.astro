---
// Ficha con los datos de una regata (Diario de regatas), como una hoja de datos
import type { Entrada } from '../lib/contenido';

interface Props {
  regata: Entrada['data']['regata'];
}
const { regata: r } = Astro.props;
const datos = [
  ['Regata', r.nombre],
  ['Lugar', r.lugar],
  ['Barco', r.barco],
  ['Clase', r.clase],
  ['Pruebas', r.pruebas?.toString()],
  ['Viento', r.viento],
].filter(([, v]) => v) as [string, string][];
---

<aside class="ficha" aria-label="Datos de la regata">
  {
    r.posicion && (
      <div class="posicion">
        <span class="etiqueta">Posición</span>
        <span class="cifra">
          {r.posicion}
          <sup>º</sup>
        </span>
        {r.participantes && <span class="etiqueta">de {r.participantes} barcos</span>}
      </div>
    )
  }
  <dl>
    {
      datos.map(([k, v]) => (
        <div>
          <dt class="etiqueta">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))
    }
  </dl>
  {
    r.notas && (
      <p class="notas">
        <span class="etiqueta">Notas</span>
        {r.notas}
      </p>
    )
  }
</aside>

<style>
  .ficha {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 52rem;
    margin: 0 0 var(--e-12);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--superficie);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .ficha {
      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }
  .posicion {
    display: grid;
    align-content: start;
    gap: var(--e-1);
    padding: var(--e-4) var(--e-6);
    border-bottom: 1px solid var(--linea);
    background: var(--fondo);
  }
  @media (min-width: 640px) {
    .posicion {
      border-bottom: 0;
      border-right: 1px solid var(--linea);
      grid-row: span 2;
    }
  }
  .cifra {
    font-size: 4rem;
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--acento-texto);
    font-variant-numeric: lining-nums;
  }
  .cifra sup {
    font-size: 0.4em;
    vertical-align: 1.1em;
    margin-left: 0.04em;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    margin: 0;
  }
  dl > div {
    padding: var(--e-4) var(--e-4) var(--e-4) var(--e-6);
  }
  @media (min-width: 640px) {
    dl > div {
      padding-left: var(--e-6);
    }
  }
  dd {
    margin: var(--e-1) 0 0;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .notas {
    display: grid;
    gap: var(--e-1);
    margin: 0;
    padding: var(--e-4) var(--e-6);
    border-top: 1px solid var(--linea);
    font-size: 0.95rem;
    color: var(--tinta-2);
  }
  @media (min-width: 640px) {
    .notas {
      padding-left: var(--e-6);
    }
  }
</style>
