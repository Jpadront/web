---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { sitio } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion?: string;
  imagen?: ImageMetadata;
  tipo?: 'website' | 'article';
  fecha?: Date;
  noIndexar?: boolean;
  /** Rejilla de puntos decorativa en la parte superior (la portada lleva la suya propia) */
  rejilla?: boolean;
}
const { descripcion = sitio.descripcion, rejilla = true, ...resto } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Aplica el tema guardado antes de pintar la página (evita el parpadeo claro→oscuro) -->
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t === 'claro' || t === 'oscuro') document.documentElement.dataset.tema = t;
      } catch {}
      // Marca que hay JavaScript: solo entonces se ocultan los elementos que aparecen al hacer scroll
      document.documentElement.classList.add('js');
    </script>
    <!-- Fuentes precargadas: se ven nada más abrir la página -->
    <Font cssVariable="--fuente-texto" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--fuente-mono" preload />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070d18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${sitio.nombre} · Bitácora`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={sitio.nombre} />
    <meta name="generator" content={Astro.generator} />
    <Seo descripcion={descripcion} {...resto} />
  </head>
  <body>
    <a class="saltar solo-lectores" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido" class:list={{ "rejilla-superior": rejilla }}>
      <slot />
    </main>
    <Pie />
    <script>
      import '../scripts/efectos';
    </script>
  </body>
</html>

<style>
  .saltar:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5rem 1rem;
    background: var(--fondo);
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radio);
    z-index: 100;
  }
</style>
