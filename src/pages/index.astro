---
import BaseLayout from '../layouts/BaseLayout.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import TarjetaEntrada from '../components/TarjetaEntrada.astro';
import RedesSociales from '../components/RedesSociales.astro';
import { sitio } from '../lib/sitio';
import { dosCifras, fechaISO, formatoFechaCorta, getEntradas, getProyectos } from '../lib/contenido';

const proyectos = await getProyectos();
// Destacados: los marcados como «destacado»; si no hay ninguno, los más recientes
const marcados = proyectos.filter((p) => p.data.destacado);
const destacados = (marcados.length ? marcados : proyectos).slice(0, 4);
const entradas = await getEntradas();
const ultimas = entradas.slice(0, 4);
const regatas = entradas.filter((e) => e.data.regata.nombre).length;

// Pequeño índice en cifras junto a la presentación (se actualiza solo)
const indice = [
  { k: 'Proyectos', v: dosCifras(proyectos.length), href: '/proyectos/' },
  { k: 'Entradas', v: dosCifras(entradas.length), href: '/bitacora/' },
  { k: 'Regatas', v: dosCifras(regatas), href: '/proyectos/diario-de-regatas/' },
];
---

<BaseLayout titulo={sitio.titulo}>
  <section class="contenedor portada">
    <div class="texto">
      <p class="etiqueta">Cuaderno de proyectos</p>
      <h1>{sitio.nombre}</h1>
      <p class="entradilla">{sitio.presentacion}</p>
      <div class="acciones">
        <a class="enlace-flecha" href="/proyectos/">Ver los proyectos</a>
        <a class="enlace-flecha" href="/bitacora/">Leer la bitácora</a>
      </div>
    </div>
    <aside class="indice" aria-label="Índice">
      <dl>
        {
          indice.map((i) => (
            <div>
              <dt class="etiqueta">{i.k}</dt>
              <dd>
                <a href={i.href}>{i.v}</a>
              </dd>
            </div>
          ))
        }
        {
          entradas[0] && (
            <div class="ultima">
              <dt class="etiqueta">Última entrada</dt>
              <dd class="mono">
                <a href={`/bitacora/${entradas[0].id}/`}>
                  <time datetime={fechaISO(entradas[0].data.fecha)}>{formatoFechaCorta(entradas[0].data.fecha)}</time>
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      <RedesSociales />
    </aside>
  </section>

  <section class="contenedor seccion">
    <div class="cabecera-seccion">
      <h2>Proyectos</h2>
      <a class="enlace-flecha" href="/proyectos/">Todos</a>
    </div>
    <div class="rejilla-proyectos">
      {destacados.map((p, i) => <TarjetaProyecto proyecto={p} numero={i + 1} prioridad={i < 2} />)}
    </div>
  </section>

  <section class="contenedor seccion">
    <div class="cabecera-seccion">
      <h2>Bitácora</h2>
      <a class="enlace-flecha" href="/bitacora/">Todas las entradas</a>
    </div>
    <div class="lista-entradas">
      {ultimas.length ? ultimas.map((e) => <TarjetaEntrada entrada={e} />) : <p class="texto-suave">Todavía no hay entradas.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .portada {
    display: grid;
    gap: var(--e-12);
    padding-block: clamp(var(--e-12), 9vw, 8.5rem) clamp(var(--e-8), 4vw, var(--e-12));
  }
  @media (min-width: 900px) {
    .portada {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: end;
    }
  }
  h1 {
    margin: var(--e-4) 0 var(--e-6);
  }
  .entradilla {
    margin-bottom: var(--e-8);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3) var(--e-8);
  }
  .indice dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 var(--e-6);
    border-top: 1px solid var(--linea);
  }
  .indice dl > div {
    padding: var(--e-3) 0;
    border-bottom: 1px solid var(--linea);
  }
  .indice dl > div {
    padding-right: var(--e-3);
  }
  .ultima {
    grid-column: 1 / -1;
  }
  dd {
    margin: 0;
    font-family: var(--titulos);
    font-size: 2rem;
    line-height: 1.2;
    font-variant-numeric: tabular-nums lining-nums;
  }
  dd.mono {
    font-family: var(--mono);
    font-size: 0.95rem;
    padding-top: 0.2rem;
  }
  dd a {
    color: var(--tinta);
    text-decoration: none;
  }
  dd a:hover {
    color: var(--acento-texto);
  }
  .rejilla-proyectos {
    display: grid;
    gap: var(--e-12) var(--e-8);
  }
  @media (min-width: 700px) {
    .rejilla-proyectos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .lista-entradas {
    max-width: 52rem;
  }
</style>
