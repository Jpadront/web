---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Etiquetas from '../../components/Etiquetas.astro';
import FichaRegata from '../../components/FichaRegata.astro';
import { fechaISO, formatoFecha, getEntradas, minutosLectura, type Entrada } from '../../lib/contenido';

export const getStaticPaths = (async () => {
  const entradas = await getEntradas();
  // Anterior / siguiente dentro del orden cronológico
  return entradas.map((entrada, i) => ({
    params: { id: entrada.id },
    props: { entrada, posterior: entradas[i - 1], anterior: entradas[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entrada: Entrada;
  anterior?: Entrada;
  posterior?: Entrada;
}
const { entrada, anterior, posterior } = Astro.props;
const d = entrada.data;
const proyecto = d.proyecto ? await getEntry(d.proyecto) : undefined;
const { Content } = await render(entrada);
const minutos = minutosLectura(entrada.body);
---

<BaseLayout titulo={d.titulo} descripcion={d.resumen} imagen={d.portada} tipo="article" fecha={d.fecha}>
  <article class="contenedor seccion">
    <header class="cabecera-entrada">
      <p class="etiqueta">
        <a href="/bitacora/">Bitácora</a>
        {proyecto && <> / <a href={`/proyectos/${proyecto.id}/`}>{proyecto.data.titulo}</a></>}
      </p>
      <h1>{d.titulo}</h1>
      <p class="entradilla">{d.resumen}</p>
      <p class="meta etiqueta">
        <time datetime={fechaISO(d.fecha)}>{formatoFecha(d.fecha)}</time>
        <span>{minutos} min de lectura</span>
      </p>
    </header>

    {d.regata.nombre && <FichaRegata regata={d.regata} />}

    {
      d.portada && (
        <figure class="portada">
          <Image
            src={d.portada}
            alt={d.portada_alt ?? ''}
            widths={[720, 1080, 1440, 1920]}
            sizes="(max-width: 1240px) 94vw, 1160px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="prosa">
      <Content />
    </div>

    {
      d.etiquetas.length > 0 && (
        <div class="etiquetas-final">
          <Etiquetas etiquetas={d.etiquetas} />
        </div>
      )
    }

    <nav class="navegacion" aria-label="Más entradas">
      {
        anterior ? (
          <a href={`/bitacora/${anterior.id}/`}>
            <span class="etiqueta">← Anterior</span>
            <span class="t">{anterior.data.titulo}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        posterior && (
          <a class="derecha" href={`/bitacora/${posterior.id}/`}>
            <span class="etiqueta">Siguiente →</span>
            <span class="t">{posterior.data.titulo}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .cabecera-entrada {
    max-width: 52rem;
    margin-bottom: var(--e-12);
  }
  .cabecera-entrada h1 {
    margin: var(--e-3) 0 var(--e-6);
    font-size: clamp(2.2rem, 1.5rem + 2.8vw, 3.6rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-6);
    margin: var(--e-6) 0 0;
    padding-top: var(--e-4);
    border-top: 1px solid var(--linea);
  }
  .portada {
    margin: 0 0 var(--e-12);
  }
  .portada :global(img) {
    width: 100%;
    border-radius: var(--radio);
    box-shadow:
      0 0 0 1px var(--linea),
      var(--sombra);
  }
  .etiquetas-final {
    max-width: var(--ancho-texto);
    margin-top: var(--e-8);
  }
  .navegacion {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-8);
    margin-top: var(--e-16);
  }
  .navegacion a {
    display: grid;
    align-content: start;
    gap: var(--e-2);
    padding: var(--e-4) var(--e-6);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    color: var(--tinta);
    transition:
      border-color var(--transicion),
      background-color var(--transicion);
  }
  .navegacion a:hover {
    border-color: color-mix(in srgb, var(--acento) 45%, var(--linea));
    background: var(--superficie);
  }
  .navegacion a:hover .t {
    color: var(--acento-texto);
  }
  .t {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    transition: color var(--transicion);
  }
  .derecha {
    text-align: right;
  }
  @media (max-width: 600px) {
    .navegacion {
      grid-template-columns: 1fr;
    }
    .derecha {
      text-align: left;
    }
  }
</style>
