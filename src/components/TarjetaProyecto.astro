---
import { Image } from 'astro:assets';
import { CATEGORIAS, ESTADOS } from '../lib/constantes';
import { dosCifras, type Proyecto } from '../lib/contenido';

interface Props {
  proyecto: Proyecto;
  /** Número de orden que se muestra («01», «02»…) */
  numero?: number;
  /** true en las primeras tarjetas visibles: carga la imagen sin esperar (mejor LCP) */
  prioridad?: boolean;
}
const { proyecto, numero, prioridad = false } = Astro.props;
const d = proyecto.data;
---

<article class="tarjeta" data-categoria={d.categoria} data-estado={d.estado}>
  <div class="imagen">
    {
      d.portada ? (
        <Image
          src={d.portada}
          alt={d.portada_alt ?? ''}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1200px) 46vw, 560px"
          loading={prioridad ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="sin-imagen" aria-hidden="true" />
      )
    }
  </div>
  <p class="meta etiqueta">
    {numero != null && <span class="numero">{dosCifras(numero)}</span>}
    <span>{CATEGORIAS[d.categoria]}</span>
    <span>{d.fecha_inicio.getUTCFullYear()}</span>
    {d.borrador && <span class="borrador">Borrador</span>}
  </p>
  <h3>
    <!-- El enlace ocupa toda la tarjeta (ver ::after) -->
    <a href={`/proyectos/${proyecto.id}/`}>{d.titulo}</a>
  </h3>
  <p class="resumen">{d.resumen}</p>
  <p class:list={['estado', `estado-${d.estado}`]}>{ESTADOS[d.estado]}</p>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .imagen {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--marino);
    /* Filete interior: un borde fino que no ocupa espacio */
    box-shadow: inset 0 0 0 1px var(--linea);
  }
  .imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0, 0, 1);
  }
  .tarjeta:hover .imagen :global(img) {
    transform: scale(1.025);
  }
  .sin-imagen {
    height: 100%;
    background: linear-gradient(135deg, var(--marino), var(--marino-2));
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin: var(--e-4) 0 var(--e-2);
  }
  .numero {
    color: var(--acento-texto);
  }
  .borrador {
    color: var(--acento-texto);
  }
  h3 {
    margin: 0 0 var(--e-2);
    font-size: clamp(1.4rem, 1.25rem + 0.5vw, 1.65rem);
    letter-spacing: -0.015em;
  }
  h3 a {
    color: var(--tinta);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 300ms cubic-bezier(0.2, 0, 0, 1);
  }
  /* Detalle: el título se subraya de izquierda a derecha al pasar por la tarjeta */
  .tarjeta:hover h3 a {
    background-size: 100% 1px;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .resumen {
    margin: 0 0 var(--e-3);
    color: var(--tinta-2);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  .estado {
    margin: auto 0 0;
    font-size: 0.82rem;
    color: var(--tinta-2);
  }
</style>
